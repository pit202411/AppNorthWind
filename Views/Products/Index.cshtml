@model AppNorthWind.Models.PagedViewModel<AppNorthWind.Products>

@{
    ViewBag.Title = "Products";

    string currentSort = Model.SortOrder;
}

<h2>Products</h2>

<button class="buttonAdd">
    @Html.ActionLink("Create New", "Create", null, new { @class = "buttonAddText" })
</button>
<table class="table">
    <tr>

        <th>
            @if (currentSort == "ProductNameAsc")
            {
                @Html.ActionLink(
                    "Product Name (A-Z)",
                    "Index",
                    new { sortOrder = "ProductNameDesc" }
                )
            }
            else
            {
                @Html.ActionLink(
                    "Product Name (Z-A)",
                    "Index",
                    new { sortOrder = "ProductNameAsc" }
                )
            }
        </th>
        <th>
            @Html.ActionLink(
                "Supplier Name",
                "Index",
                new { sortOrder = "SupplierName" }
            )
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemMetadata.Categories.CategoryName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemMetadata.QuantityPerUnit)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemMetadata.UnitPrice)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemMetadata.UnitsInStock)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemMetadata.UnitsOnOrder)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemMetadata.ReorderLevel)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemMetadata.Discontinued)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model.Items)
    {
        <tr>

            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SupplierName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.QuantityPerUnit)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitsInStock)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitsOnOrder)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReorderLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Discontinued)
            </td>
            <td class="action-buttons">

                <a href="@Url.Action("Edit", new { id = item.ProductID })"
                   class="action-button edit-button"
                   title="Edit">
                    <i class="bi bi-pencil"></i>
                </a>

                <a href="@Url.Action("Details", new { id = item.ProductID })"
                   class="action-button details-button"
                   title="Details">
                    <i class="bi bi-eye"></i>
                </a>

                <a href="@Url.Action("Delete", new { id = item.ProductID })"
                   class="action-button delete-button"
                   title="Delete">
                    <i class="bi bi-trash"></i>
                </a>

            </td>
        </tr>
    }

</table>
<div class="pagination">

    @if (Model.CurrentPage > 1)
    {
        @Html.ActionLink(
            "←",
            "Index",
            new
            {
                page = Model.CurrentPage - 1,
                sortOrder = Model.SortOrder
            },
            new { @class = "pagination-button" }
        )
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.CurrentPage)
        {
            <span class="pagination-button active">
                @i
            </span>
        }
        else
        {
            @Html.ActionLink(
                i.ToString(),
                "Index",
                new
                {
                    page = i,
                    sortOrder = Model.SortOrder
                },
                new { @class = "pagination-button" }
            )
        }
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        @Html.ActionLink(
            "→",
            "Index",
            new
            {
                page = Model.CurrentPage + 1,
                sortOrder = Model.SortOrder
            },
            new { @class = "pagination-button" }
        )
    }

</div>

